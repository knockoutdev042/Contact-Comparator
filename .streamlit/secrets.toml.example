# Copy this file to .streamlit/secrets.toml for local development.
# secrets.toml is git-ignored — it will never be committed.
#
# Generate a hash for each user with:
#   python scripts/hash_password.py

[app_users]
"jane@lghomecomfort.ca" = "$2b$12$replace-with-a-real-bcrypt-hash"
"john@lghomecomfort.ca" = "$2b$12$replace-with-another-bcrypt-hash"
